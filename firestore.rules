rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colecciones de la app: solo usuarios autenticados
    match /clientes/{id} {
      allow read, write: if request.auth != null;
    }
    match /paquetes/{id} {
      allow read, write: if request.auth != null;
    }
    match /envios/{id} {
      allow read, write: if request.auth != null;
    }

    // Registro de correos enviados vía Apps Script.
    // La app crea el correo y luego solo puede anotar el resultado de entrega ("delivery").
    match /mail/{id} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['to', 'message']);
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delivery']);
    }
  }
}
