<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgFotoPaqueteItem"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="Foto del paquete" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblTipoPaqueteItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo: Caja"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/lblContenidoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contenido: Artículos varios"
                android:textSize="14sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/lblPesoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peso: 2.5 Kg"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/lblFragilItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ FRÁGIL ]"
                android:textSize="12sp"
                android:textColor="#F44336"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                tools:visibility="visible"/>

            <Button
                android:id="@+id/btnVerFotoDrive"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#2196F3"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="📷 Foto en Google Drive"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnEditarPaquete"
                android:layout_width="85dp"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
                android:backgroundTint="#4CAF50"
                android:padding="0dp"
                android:text="Editar"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnBorrarPaquete"
                android:layout_width="85dp"
                android:layout_height="44dp"
                android:backgroundTint="#F44336"
                android:padding="0dp"
                android:text="Borrar"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>